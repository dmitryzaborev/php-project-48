{
    "name": "hexlet/code",
    "description": "Two project - Gendiff",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4":{
            "Gendiff\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Dmitry Zaborev",
            "email": "egorov.vladimor@gmail.com"
        }
    ],
    "require": {
        "docopt/docopt": "dev-master",
        "symfony/yaml": "^6.0",
        "lstrojny/functional-php": "^1.17"
    },
        "bin": [
        "bin/gendiff"
    ],
    "require-dev": {
        "phpunit/phpunit": "10.0",
        "squizlabs/php_codesniffer": "^3.10",
        "phpstan/phpstan": "1.10.24",
        "phpstan/extension-installer": "1.4.3",
        "phpstan/phpstan-strict-rules": "^1.5",
        "hexlet/phpstan-fp": "^2.0"
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
